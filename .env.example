# Copiar a .env.local para desarrollo (npm run dev sirve /api con estas variables).
# En Vercel se configuran en Project Settings → Environment Variables;
# DATABASE_URL y BLOB_READ_WRITE_TOKEN los agregan solas las integraciones Neon y Blob.
DATABASE_URL=postgres://localhost/hassman
ADMIN_PASSWORD=cambia-esta-contraseña
SESSION_SECRET=genera-uno-con-openssl-rand-base64-48
# Opcional en local: sin él, el panel permite pegar URLs de imagen pero no subir archivos.
BLOB_READ_WRITE_TOKEN=
